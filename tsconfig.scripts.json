{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode (scripts import './src/...' and are run via tsx) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "audit.ts",
    "audit_all_flows.ts",
    "fuzz_test.ts",
    "test_all_cujs.ts",
    "test_monte_carlo_balance.ts",
    "test_routing_guards.ts",
    "analyze_traits.ts"
  ]
}
